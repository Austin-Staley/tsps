{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/waterfallquest/WaterfallQuest.java","steps":[{"text":"Talk to Almera on top of Baxtorian Falls, south of Barbarian Outpost.","target":{"x":2521,"y":3495,"plane":0},"choices":["Yes."]},{"text":"Board the log raft west of Almera.","target":{"x":2509,"y":3494,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Talk to Hudon.","target":{"x":2511,"y":3484,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Use a rope on the rock to the south.","target":{"x":2512,"y":3468,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Use a rope on the dead tree.","target":{"x":2512,"y":3465,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Get in the barrel.","target":{"x":2512,"y":3463,"plane":0}},{"text":"Go up the stairs in the house south of Almera's house.","target":{"x":2518,"y":3430,"plane":0}},{"text":"Search the south east bookcase.","target":{"x":2520,"y":3427,"plane":1}},{"text":"Read the book.","items":[{"id":292,"name":"Book on baxtorian","amount":1}]},{"text":"Go to the centre of the Tree Gnome Village and go down the ladder at the entrance.","target":{"x":2533,"y":3155,"plane":0}},{"text":"Go to the centre of the Tree Gnome Village and go down the ladder at the entrance.","target":{"x":2518,"y":3430,"plane":1}},{"text":"Search the off-coloured crate in the east room.","target":{"x":2548,"y":9565,"plane":0}},{"text":"Go through the gate in the west room.","target":{"x":2515,"y":9575,"plane":0},"items":[{"id":293,"name":"Key","amount":1}]},{"text":"Talk to Golrie.","target":{"x":2514,"y":9580,"plane":0}},{"text":"Bank everything besides the pebble and some food. Then use Glarial's pebble on Glarial's Tombstone east of Baxtorian Falls.","target":{"x":2559,"y":3445,"plane":0},"items":[{"id":294,"name":"Glarial's pebble","amount":1}]},{"text":"Search the chest in the western room for Glarial's amulet.","target":{"x":2530,"y":9844,"plane":0}},{"text":"Search Glarial's Tomb in the south room for Glarial's urn.","target":{"x":2542,"y":9812,"plane":0}},{"text":"Leave Glarial's Tomb and get 6 air, water, and earth runes, a rope, glarial's amulet, glarial's urn, and some food.","items":[{"id":556,"name":"Air runes","amount":6},{"id":557,"name":"Earth runes","amount":6},{"id":555,"name":"Water runes","amount":6},{"id":295,"name":"Glarial's amulet","amount":1,"equipped":true},{"id":296,"name":"Glarial's urn","amount":1},{"id":954,"name":"Rope","amount":1}]},{"text":"Board the log raft west of Almera.","target":{"x":2509,"y":3494,"plane":0}},{"text":"Use a rope on the rock to the south.","target":{"x":2512,"y":3468,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Use a rope on the dead tree.","target":{"x":2512,"y":3465,"plane":0},"items":[{"id":954,"name":"Rope","amount":1}]},{"text":"Equip Glarial's amulet.","items":[{"id":295,"name":"Glarial's amulet","amount":1,"equipped":true}]},{"text":"Enter the falls with Glarial's amulet equipped.","target":{"x":2511,"y":3464,"plane":0},"items":[{"id":295,"name":"Glarial's amulet","amount":1,"equipped":true}]},{"text":"Search the crate in the east room for a key.","target":{"x":2589,"y":9888,"plane":0}},{"text":"Enter the west room with the key.","target":{"x":2566,"y":9901,"plane":0},"items":[{"id":298,"name":"Key","amount":1}]},{"text":"Use 1 earth, water and air rune on each of the 6 pillars in the room. Afterwards, use Glarial's amulet on the statue of Glarial.","items":[{"id":556,"name":"Air rune","amount":1},{"id":555,"name":"Water rune","amount":1},{"id":557,"name":"Earth rune","amount":1}]},{"text":"Use Glarial's amulet on the Statue of Glarial","target":{"x":2603,"y":9915,"plane":0},"items":[{"id":295,"name":"Glarial's amulet","amount":1}]},{"text":"DO NOT LEFT-CLICK THE CHALICE! Use Glarial's urn on the Chalice to finish the quest.","target":{"x":2604,"y":9911,"plane":0},"items":[{"id":296,"name":"Glarial's urn","amount":1}]}],"panels":[{"header":"Starting off","steps":[0],"items":[{"id":954,"name":"Rope","amount":1}]},{"header":"Investigate","steps":[1,2,3,4,5,6,7,8],"items":[{"id":954,"name":"Rope","amount":1}]},{"header":"Get Glarial's Pebble","steps":[9,11,12,13],"substeps":[10]},{"header":"Loot Glarial's tomb","steps":[14,15,16]},{"header":"Put Glarial to rest","steps":[17,18,19,20,21,22,23,24,25,27],"items":[{"id":954,"name":"Rope","amount":1},{"id":556,"name":"Air runes","amount":6},{"id":557,"name":"Earth runes","amount":6},{"id":555,"name":"Water runes","amount":6},{"id":296,"name":"Glarial's urn","amount":1},{"id":295,"name":"Glarial's amulet","amount":1,"equipped":true}]}],"overview":{"required":[{"id":954,"name":"Rope","amount":1},{"id":556,"name":"Air runes","amount":6},{"id":557,"name":"Earth runes","amount":6},{"id":555,"name":"Water runes","amount":6}],"recommended":[{"id":3867,"name":"Games necklace","amount":1,"alternates":[3865,3863,3861,3859,3857,3855,3853]},{"name":"Food"}],"general":[],"generalRecommended":[],"combat":["Able to survive enemies up to level 86 attacking you"],"notes":[],"rewards":["1 Quest Point","13,750 Strength Experience","13,750 Attack Experience","2 x Diamonds","2 x Gold Bars","40 x Mithril Seeds"]}}
