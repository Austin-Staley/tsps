{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/monksfriend/MonksFriend.java","steps":[{"text":"Talk to Brother Omad in the monastery south of East Ardougne.","target":{"x":2607,"y":3211,"plane":0},"choices":["Why can't you sleep, what's wrong?","Yes."]},{"text":"Go down the ladder in a circle of stones west of the monastery.","target":{"x":2561,"y":3222,"plane":0}},{"text":"Pick up the Child's blanket in the room to the south.","target":{"x":2570,"y":9604,"plane":0},"items":[{"id":90,"name":"Child's blanket","amount":1}]},{"text":"Go back up the ladder.","target":{"x":2561,"y":9622,"plane":0},"items":[{"id":90,"name":"Child's blanket","amount":1}]},{"text":"Bring the blanket back to Brother Omad in the monastery.","target":{"x":2607,"y":3211,"plane":0},"items":[{"id":90,"name":"Child's blanket","amount":1}]},{"text":"Talk to Brother Omad again.","target":{"x":2607,"y":3211,"plane":0},"choices":["Is there anything else I can help with?","Who's Brother Cedric?","Where should I look?"]},{"text":"Talk to Brother Cedric north of the monastery.","target":{"x":2614,"y":3258,"plane":0}},{"text":"Talk to Brother Cedric again.","target":{"x":2614,"y":3258,"plane":0},"items":[{"id":1937,"name":"Jug of Water","amount":1}],"choices":["Yes, I'd be happy to!"]},{"text":"Talk to Brother Cedric again.","target":{"x":2614,"y":3258,"plane":0},"choices":["Yes, I'd be happy to!"]},{"text":"Talk to Brother Cedric once again with logs.","target":{"x":2614,"y":3258,"plane":0},"items":[{"id":1511,"name":"Logs","amount":1}]},{"text":"Return to Brother Omad to finish the quest.","target":{"x":2607,"y":3211,"plane":0}}]}
