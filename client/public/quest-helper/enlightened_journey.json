{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/enlightenedjourney/EnlightenedJourney.java","steps":[{"text":"Bank all weapons and armour you have, and go to Port Sarim to get a boat to Entrana.","target":{"x":3047,"y":3236,"plane":0}},{"text":"Talk to Auguste on Entrana 3 times.","target":{"x":2809,"y":3354,"plane":0},"items":[{"id":970,"name":"Papyrus","amount":3},{"id":1759,"name":"Ball of wool","amount":1}],"choices":["Yes! Sign me up.","Umm, yes. What's your point?","Yes."]},{"text":"Use papyrus on a ball of wool.","items":[{"id":970,"name":"Papyrus","amount":1},{"id":1759,"name":"Ball of wool","amount":1}]},{"text":"Use a candle on the balloon.","items":[{"id":36,"name":"Unlit candle","amount":1,"alternates":[38]},{"id":9933,"name":"Balloon structure","amount":1}]},{"text":"Talk to Auguste again.","target":{"x":2809,"y":3354,"plane":0},"items":[{"id":9934,"name":"Origami balloon","amount":1}],"choices":["Yes, I have them here."]},{"text":"Talk to Auguste with 2 papyrus and a sack of potatoes.","target":{"x":2809,"y":3354,"plane":0},"items":[{"id":970,"name":"Papyrus","amount":2},{"id":5438,"name":"Sack of potatoes (10)","amount":1}],"choices":["Yes, I have them here."]},{"text":"Talk to Auguste after the flash mob.","target":{"x":2809,"y":3354,"plane":0}},{"text":"Fill your empty sacks on the sand pit south of Auguste.","target":{"x":2817,"y":3342,"plane":0},"items":[{"id":5418,"name":"Empty sack","amount":8,"alternates":[9943]}]},{"text":"Get 12 willow branches and use them on the platform next to Auguste to make the basket.","target":{"x":2807,"y":3356,"plane":0},"items":[{"id":5933,"name":"Willow branches","amount":12}]},{"text":"Talk to Auguste to fly.","target":{"x":2809,"y":3354,"plane":0},"items":[{"id":1511,"name":"Logs","amount":10},{"id":590,"name":"Tinderbox","amount":1}],"choices":["Okay."]},{"text":"Talk to Auguste in Taverley to finish the quest.","targ