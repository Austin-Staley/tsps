{
  "_comment": [
    "Declarative building presets for the agent map-editing tools (EditBuild.AgentMcp.js).",
    "A preset is a list of parts; each part is a shape from EditGeometry.AgentMcp.js plus a",
    "material name from `materials` below. Values written as \"$name\" are taken from the call's",
    "`params`, so one preset covers many sizes. Geometry is relative to the origin tile the",
    "agent gives, and rotation is applied around that origin.",
    "Materials are verified cache ids (yarn dump:loc / search_objects); add new ones here rather",
    "than hard-coding numbers in tools."
  ],
  "materials": {
    "castle_wall": { "id": 16519, "about": "Grey crenellated stone wall, the best white-city wall in the cache" },
    "battlement": { "id": 2832, "about": "Squat crenellated stone block; stacks into towers and parapets" },
    "gate": { "id": 37, "about": "Openable wooden gate" },
    "arch": { "id": 2106, "about": "Stone archway, walked through" },
    "stair": { "id": 54, "about": "Stone staircase" },
    "brazier": { "id": 11017, "about": "Standing brazier" },
    "marble_bench": { "id": 29115, "about": "Marble bench" },
    "statue_king": { "id": 563, "about": "Statue of a king" },
    "oak": { "id": 8462, "about": "Oak tree" }
  },
  "presets": {
    "house": {
      "about": "Walled house shell with a doorway; hollow, so it can be furnished.",
      "params": { "width": 5, "height": 5, "doorSide": "south", "wall": "castle_wall" },
      "parts": [
        { "shape": "box", "material": "$wall", "x": 0, "y": 0, "width": "$width", "height": "$height", "doorSide": "$doorSide" }
      ]
    },
    "tower": {
      "about": "Square tower footprint with a parapet ring around it.",
      "params": { "size": 3, "body": "battlement", "parapet": "castle_wall" },
      "parts": [
        { "shape": "tower", "material": "$body", "x": 0, "y": 0, "width": "$size", "height": "$size" },
        { "shape": "box", "material": "$parapet", "x": -1, "y": -1, "width": "$size", "height": "$size", "grow": 2 }
      ]
    },
    "gatehouse": {
      "about": "Gate flanked by battlement piers, with an archway behind it.",
      "params": { "wall": "battlement", "gate": "gate", "arch": "arch" },
      "parts": [
        { "shape": "column", "material": "$wall", "dx": 0, "dy": -2 },
        { "shape": "column", "material": "$wall", "dx": 0, "dy": 2 },
        { "shape": "column", "material": "$gate", "dx": 0, "dy": 0, "face": 1 },
        { "shape": "column", "material": "$arch", "dx": 1, "dy": 0 }
      ]
    },
    "plaza": {
      "about": "Open square: king statues at the corners, braziers mid-side, marble benches inside.",
      "params": { "radius": 4, "statue": "statue_king", "brazier": "brazier", "bench": "marble_bench" },
      "parts": [
        { "shape": "column", "material": "$statue", "dx": "-$radius", "dy": "-$radius" },
        { "shape": "column", "material": "$statue", "dx": "$radius", "dy": "-$radius" },
        { "shape": "column", "material": "$statue", "dx": "-$radius", "dy": "$radius" },
        { "shape": "column", "material": "$statue", "dx": "$radius", "dy": "$radius" },
        { "shape": "column", "material": "$brazier", "dx": 0, "dy": "-$radius" },
        { "shape": "column", "material": "$brazier", "dx": 0, "dy": "$radius" },
        { "shape": "column", "material": "$bench", "dx": "-1", "dy": 1 },
        { "shape": "column", "material": "$bench", "dx": "1", "dy": 1 }
      ]
    },
    "tiered_city": {
      "about": "Ringed hill city: four concentric walls with east gates, cardinal towers, and a keep at the summit. Pair with set_height terraces for the stepped look.",
      "params": {
        "radii": [8, 13, 18, 23],
        "wall": "castle_wall",
        "tower": "battlement",
        "gate": "gate",
        "arch": "arch"
      },
      "repeat": { "radius": "$radii" },
      "parts": [
        { "shape": "ring", "material": "$wall", "radius": "$radius", "thickness": 1, "gapDegrees": 20, "gapAngle": 0 },
        { "shape": "column", "material": "$gate", "dx": "$radius", "dy": 0, "face": 1 },
        { "shape": "column", "material": "$arch", "dx": "$radius", "dy": 0 },
        { "shape": "column", "material": "$tower", "dx": "$radius", "dy": "-2" },
        { "shape": "column", "material": "$tower", "dx": "$radius", "dy": "2" },
        { "shape": "column", "material": "$tower", "dx": "-$radius", "dy": "-2" },
        { "shape": "column", "material": "$tower", "dx": "-$radius", "dy": "2" }
      ]
    }
  }
}
