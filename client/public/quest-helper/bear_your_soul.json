{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/bearyoursoul/BearYourSoul.java","steps":[{"text":"Go to the Arceuus library and find The Soul journey book in one of the bookcases, then read it. You can ask Biblia for help locating it, or make use of the Runelite Kourend Library plugin.","target":{"x":1632,"y":3808,"plane":0}},{"text":"Talk to Aretha at the Soul Altar.","target":{"x":1814,"y":3851,"plane":0},"choices":["I've been reading your book...","Yes please."]},{"text":"Go to the Arceuus church and dig for the Damaged soul bearer.","target":{"x":1699,"y":3794,"plane":0}},{"text":"Go to Taverley Dungeon, or teleport to the Key Master directly.","target":{"x":2884,"y":3397,"plane":0},"items":[{"id":19636,"name":"Damaged soul bearer","amount":1}]},{"text":"Enter the cave to the Key Master.","target":{"x":2874,"y":9846,"plane":0},"items":[{"id":19636,"name":"Damaged soul bearer","amount":1}]},{"text":"Talk to Key Master in the Cerberus' Lair.","target":{"x":1310,"y":1251,"plane":0},"items":[{"id":19636,"name":"Damaged soul bearer","amount":1}]}],"panels":[{"header":"Find the Soul journey book","steps":[0]},{"header":"Talk to Aretha","steps":[1]},{"header":"Dig up the Soul Bearer","steps":[2],"items":[{"id":952,"name":"Spade","amount":1}]},{"header":"Have the Soul Bearer repaired","steps":[3,4,5],"items":[]}],"overview":{"required":[],"recommended":[],"general":[],"generalRecommended":[],"combat":[],"notes":[],"rewards":["A Soul Bearer"]}}
