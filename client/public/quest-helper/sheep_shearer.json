{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/sheepshearer/SheepShearer.java","steps":[{"text":"Talk to Fred the Farmer north of Lumbridge to start the quest. Bring 20 balls of wool to autocomplete the quest.","target":{"x":3190,"y":3273,"plane":0},"choices":["I'm looking for a quest.","Yes, okay. I can do that.","Yes."]},{"text":"Pickup the shears in Fred's house.","target":{"x":3190,"y":3273,"plane":0},"items":[{"id":1735,"name":"Shears","amount":1}],"type":"item"},{"text":"Shear sheep in the nearby field.","target":{"x":3201,"y":3268,"plane":0},"items":[{"id":1735,"name":"Shears","amount":1},{"id":1737,"name":"Wool","amount":20,"alternates":[1759]}]},{"text":"Climb the staircase in the Lumbridge Castle to spin the wool in your inventory into balls of wool.","target":{"x":3204,"y":3207,"plane":0},"items":[{"id":1737,"name":"Wool","amount":20,"alternates":[1759]}]},{"text":"Spin your wool into balls.","target":{"x":3209,"y":3212,"plane":1},"items":[{"id":1737,"name":"Wool","amount":20,"alternates":[1759]}]},{"text":"Climb down the staircase.","target":{"x":3204,"y":3207,"plane":1},"items":[{"id":1759,"name":"Balls of wool","amount":20}],"choices":["Climb down the stairs."]},{"text":"Bring Fred the Farmer north of Lumbridge your balls of wool (UNNOTED) to progress the quest. If you only have some of the balls needed, you can still deposit them with him.","target":{"x":3190,"y":3273,"plane":0},"items":[{"id":1759,"name":"Balls of wool","amount":20}],"choices":["I need to talk to you about shearing these sheep!"]}],"panels":[{"header":"Bring Fred Some Wool","steps":[0,1,2,3,4,5,6],"items":[{"id":1759,"name":"Balls of wool","amount":20}]}],"overview":{"required":[{"id":1759,"name":"Balls of wool","amount":20},{"id":1735,"name":"Shears","amount":1}],"recommended":[],"general":[],"generalRecommended":[],"combat":[],"notes":[],"rewards":["1 Quest Point","150 Crafting Experience","60 x Coins"]}}
