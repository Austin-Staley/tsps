{"source":"https://github.com/Zoinkwiz/quest-helper/blob/08bb7c55ffc5aa61b7f4df61820967d63157e389/src/main/java/com/questhelper/helpers/quests/recipefordisaster/RFDAwowogei.java","steps":[{"text":"Go inspect Awowogei in Lumbridge Castle.","target":{"x":3213,"y":3221,"plane":0}},{"text":"Inspect Awowogei.","target":{"x":1865,"y":5319,"plane":0}},{"text":"Talk to Awowogei on Ape Atoll.","target":{"x":2803,"y":2765,"plane":0},"items":[{"id":4031,"name":"Any greegree","amount":1,"alternates":[4026,4028,4027,19525,4024,4029,4030,4025]},{"id":4021,"name":"M'speak amulet","amount":1,"equipped":true}]},{"text":"Talk to the three monkeys sat in the temple.","target":{"x":2789,"y":2795,"plane":0},"items":[{"id":4031,"name":"Any greegree","amount":1,"alternates":[4026,4028,4027,19525,4024,4029,4030,4025]},{"id":4021,"name":"M'speak amulet","amount":1,"equipped":true}],"choices":["Do you know anything about the King's favourite dish?"]},{"text":"Use a banana on the one of the three monkeys.","target":{"x":2789,"y":2795,"plane":0},"items":[{"id":1963,"name":"Banana","amount":1},{"id":4031,"name":"Any greegree","amount":1,"alternates":[4026,4028,4027,19525,4024,4029,4030,4025]},{"id":4021,"name":"M'speak amulet","amount":1,"equipped":true}]},{"text":"Use some monkey nuts on the one of the three monkeys.","target":{"x":2789,"y":2795,"plane":0},"items":[{"id":4012,"name":"Monkey nuts","amount":1},{"id":4031,"name":"Any greegree","amount":1,"alternates":[4026,4028,4027,19525,4024,4029,4030,4025]},{"id":4021,"name":"M'speak amulet","amount":1,"equipped":true}]},{"text":"Travel to Crash Island with Lumdo.","target":{"x":2802,"y":2706,"plane":0}},{"text":"Enter the hole on Crash Island. Protect melee when entering as you'll be attacked straight away by snakes.","target":{"x":2922,"y":2722,"plane":0},"choices":["Yes, I'm as hard as nails."]},{"text":"Kill a Big Snake for its corpse. Kill a few in case you burn it.","target":{"x":3019,"y":5485,"plane":0},"items":[{"id":7576,"name":"Snake corpse","amount":1}]},{"text":"Leave the hole.","target":{"x":3024,"y":5489,"plane":0}},{"text":"Travel back to Ape Atoll with Lumdo.","target":{"x":2892,"y":2723,"plane":0}},{"text":"Use a rope on the red banana tree on the north west of Ape Atoll as a gorilla.","target":{"x":2697,"y":2786,"plane":0},"items":[{"id":4026,"name":"Gorilla greegree","amount":1,"equipped":true,"alternates":[4028,4027]},{"id":954,"name":"Rope","amount":1}]},{"text":"Go around the monkey agility course until you reach a hole, and go down it.","target":{"x":2758,"y":2729,"plane":0},"items":[{"id":4024,"name":"Ninja greegree","amount":1,"equipped":true,"alternates":[4025,19525]}]},{"text":"Take a nut from the bush.","target":{"x":3021,"y":5458,"plane":0}},{"text":"Use a pestle and mortar on the tchiki nuts. Get more tchiki nut paste as desired in case you burn the final meal.","items":[{"id":233,"name":"Pestle and mortar","amount":1},{"id":7573,"name":"Tchiki monkey nuts","amount":1}]},{"text":"Use a knife/slash weapon on the red banana. Get more sliced red bananas as desired in case you burn the final meal.","items":[{"id":946,"name":"Knife","amount":1},{"id":7572,"name":"Red banana","amount":1}]},{"text":"Use the paste on the snake to stuff it.","items":[{"id":7575,"name":"Tchiki nut paste","amount":1},{"id":7574,"name":"Sliced red banana","amount":1},{"id":7576,"name":"Snake corpse","amount":1}]},{"text":"Enter the trapdoor in the monkey temple.","target":{"x":2807,"y":2785,"plane":0},"items":[{"id":4029,"name":"Zombie greegree","amount":1,"equipped":true,"alternates":[4030]},{"id":7577,"name":"Raw stuffed snake","amount":1}]},{"text":"Enter the hole just under where you entered.","target":{"x":2805,"y":9199,"plane":0},"items":[{"id":4029,"name":"Zombie greegree","amount":1,"equipped":true,"alternates":[4030]},{"id":7577,"name":"Raw stuffed snake","amount":1}]},{"text":"Go across the hot rocks with the zombie greegree equipped. Cook the stuffed snake on the rock at the end of the room."